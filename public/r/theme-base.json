{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-base",
  "title": "Theme base",
  "description": "Shared design-system CSS: imports, dark variant, fonts, type steps, @theme inline token mappings, radius scale and base type styles. Sets no colors; add a theme too.",
  "dependencies": [
    "@fontsource-variable/outfit",
    "@fontsource-variable/public-sans"
  ],
  "devDependencies": [
    "shadcn",
    "tw-animate-css"
  ],
  "registryDependencies": [
    "@dataservices/utils"
  ],
  "cssVars": {
    "theme": {
      "font-heading": "'Outfit Variable', system-ui, sans-serif",
      "font-sans": "'Public Sans Variable', system-ui, sans-serif",
      "text-display": "clamp(4rem, 2.4rem + 4vw, 6.5rem)",
      "text-display--line-height": "0.9",
      "text-display--letter-spacing": "-0.02em",
      "text-display--font-weight": "700",
      "text-eyebrow": "0.75rem",
      "text-eyebrow--line-height": "1.4",
      "text-eyebrow--letter-spacing": "0.08em",
      "text-eyebrow--font-weight": "600",
      "color-sidebar-ring": "var(--sidebar-ring)",
      "color-sidebar-border": "var(--sidebar-border)",
      "color-sidebar-accent-foreground": "var(--sidebar-accent-foreground)",
      "color-sidebar-accent": "var(--sidebar-accent)",
      "color-sidebar-primary-foreground": "var(--sidebar-primary-foreground)",
      "color-sidebar-primary": "var(--sidebar-primary)",
      "color-sidebar-foreground": "var(--sidebar-foreground)",
      "color-sidebar": "var(--sidebar)",
      "color-chart-5": "var(--chart-5)",
      "color-chart-4": "var(--chart-4)",
      "color-chart-3": "var(--chart-3)",
      "color-chart-2": "var(--chart-2)",
      "color-chart-1": "var(--chart-1)",
      "color-ring": "var(--ring)",
      "color-input": "var(--input)",
      "color-border": "var(--border)",
      "color-destructive": "var(--destructive)",
      "color-primary-light": "var(--primary-light)",
      "color-primary-dark": "var(--primary-dark)",
      "color-secondary-strong": "var(--secondary-strong)",
      "color-secondary-dark": "var(--secondary-dark)",
      "color-success": "var(--success)",
      "color-success-foreground": "var(--success-foreground)",
      "color-success-soft": "var(--success-soft)",
      "color-success-strong": "var(--success-strong)",
      "color-warning": "var(--warning)",
      "color-warning-foreground": "var(--warning-foreground)",
      "color-warning-soft": "var(--warning-soft)",
      "color-warning-strong": "var(--warning-strong)",
      "color-info": "var(--info)",
      "color-info-foreground": "var(--info-foreground)",
      "color-info-soft": "var(--info-soft)",
      "color-info-strong": "var(--info-strong)",
      "color-destructive-foreground": "var(--destructive-foreground)",
      "color-destructive-soft": "var(--destructive-soft)",
      "color-destructive-strong": "var(--destructive-strong)",
      "color-on-image": "var(--on-image)",
      "color-on-image-muted": "var(--on-image-muted)",
      "color-on-image-surface": "var(--on-image-surface)",
      "color-on-image-border": "var(--on-image-border)",
      "color-on-image-ring": "var(--on-image-ring)",
      "color-accent-on-dark": "var(--accent-on-dark)",
      "color-tone-1": "var(--tone-1)",
      "color-tone-1-foreground": "var(--tone-1-foreground)",
      "color-tone-1-soft": "var(--tone-1-soft)",
      "color-tone-1-strong": "var(--tone-1-strong)",
      "color-tone-2": "var(--tone-2)",
      "color-tone-2-foreground": "var(--tone-2-foreground)",
      "color-tone-2-soft": "var(--tone-2-soft)",
      "color-tone-2-strong": "var(--tone-2-strong)",
      "color-tone-3": "var(--tone-3)",
      "color-tone-3-foreground": "var(--tone-3-foreground)",
      "color-tone-3-soft": "var(--tone-3-soft)",
      "color-tone-3-strong": "var(--tone-3-strong)",
      "color-tone-4": "var(--tone-4)",
      "color-tone-4-foreground": "var(--tone-4-foreground)",
      "color-tone-4-soft": "var(--tone-4-soft)",
      "color-tone-4-strong": "var(--tone-4-strong)",
      "color-tone-5": "var(--tone-5)",
      "color-tone-5-foreground": "var(--tone-5-foreground)",
      "color-tone-5-soft": "var(--tone-5-soft)",
      "color-tone-5-strong": "var(--tone-5-strong)",
      "color-tone-6": "var(--tone-6)",
      "color-tone-6-foreground": "var(--tone-6-foreground)",
      "color-tone-6-soft": "var(--tone-6-soft)",
      "color-tone-6-strong": "var(--tone-6-strong)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-accent": "var(--accent)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-muted": "var(--muted)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-primary": "var(--primary)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-popover": "var(--popover)",
      "color-card-foreground": "var(--card-foreground)",
      "color-card": "var(--card)",
      "color-foreground": "var(--foreground)",
      "color-background": "var(--background)",
      "radius-sm": "calc(var(--radius) * 0.6)",
      "radius-md": "calc(var(--radius) * 0.8)",
      "radius-lg": "var(--radius)",
      "radius-xl": "calc(var(--radius) * 1.4)",
      "radius-2xl": "calc(var(--radius) * 1.8)",
      "radius-3xl": "calc(var(--radius) * 2.2)",
      "radius-4xl": "calc(var(--radius) * 2.6)"
    }
  },
  "css": {
    "@import \"tw-animate-css\"": {},
    "@import \"shadcn/tailwind.css\"": {},
    "@import \"@fontsource-variable/public-sans\"": {},
    "@import \"@fontsource-variable/outfit\"": {},
    "@custom-variant dark (&:is(.dark *))": {},
    "@layer base": {
      "*": {
        "@apply border-border outline-ring/50": {}
      },
      "body": {
        "@apply bg-background text-foreground font-sans": {},
        "font-size": "16px",
        "line-height": "1.5"
      },
      "h1, h2, h3, h4, h5, h6": {
        "font-family": "var(--font-heading)",
        "color": "var(--foreground)"
      },
      "h1": {
        "font-weight": "700",
        "font-size": "48px",
        "line-height": "1.4"
      },
      "h2": {
        "font-weight": "600",
        "font-size": "36px",
        "line-height": "1.5"
      },
      "h3": {
        "font-weight": "500",
        "font-size": "28px",
        "line-height": "1.5"
      },
      "h4": {
        "font-weight": "500",
        "font-size": "22px",
        "line-height": "1.6"
      },
      "@media (max-width: 600px)": {
        "h1": {
          "font-size": "36px"
        },
        "h2": {
          "font-size": "28px"
        },
        "h3": {
          "font-size": "24px",
          "line-height": "1.6"
        },
        "h4": {
          "font-size": "20px"
        },
        "body": {
          "font-size": "14px"
        }
      }
    }
  },
  "docs": "The CLI merged the design system's base CSS into your CSS entry. It sets no colors, so the app also needs a theme such as @dataservices/theme-ocotillo. It defines the dark variant as (&:is(.dark *)), like shadcn's templates; if your CSS already had a different @custom-variant dark, delete one of the two. See THEMING.md in the DataServices design system.",
  "type": "registry:style"
}