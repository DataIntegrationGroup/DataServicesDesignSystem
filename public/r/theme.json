{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "OcotilloUI Theme (legacy)",
  "description": "Legacy: merges the OcotilloUI palette into the app's CSS as shadcn cssVars. New apps should install theme-base plus one theme file (theme-ocotillo, theme-nmwdi); see THEMING.md. OcotilloUI (NMBGMRDataManager) production palette and typography — blue/amber/red/orange/emerald/cyan over stone (light) and zinc (dark) neutrals. Outfit headings, Public Sans body.",
  "dependencies": [
    "@fontsource-variable/outfit",
    "@fontsource-variable/public-sans"
  ],
  "cssVars": {
    "theme": {
      "font-heading": "'Outfit Variable', system-ui, sans-serif",
      "font-sans": "'Public Sans Variable', system-ui, sans-serif"
    },
    "light": {
      "background": "#fafafa",
      "foreground": "#0f172a",
      "card": "#ffffff",
      "card-foreground": "#0f172a",
      "popover": "#ffffff",
      "popover-foreground": "#0f172a",
      "primary": "#1d4ed8",
      "primary-foreground": "#ffffff",
      "secondary": "#d97706",
      "secondary-foreground": "#ffffff",
      "muted": "#f5f5f4",
      "muted-foreground": "#64748b",
      "accent": "#f5f5f4",
      "accent-foreground": "#0f172a",
      "destructive": "#dc2626",
      "border": "#d6d3d1",
      "input": "#d6d3d1",
      "ring": "#1d4ed8",
      "chart-1": "#1d4ed8",
      "chart-2": "#d97706",
      "chart-3": "#047857",
      "chart-4": "#0891b2",
      "chart-5": "#dc2626",
      "radius": "0.5rem",
      "sidebar": "#fafafa",
      "sidebar-foreground": "#0f172a",
      "sidebar-primary": "#1d4ed8",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "#f5f5f4",
      "sidebar-accent-foreground": "#0f172a",
      "sidebar-border": "#d6d3d1",
      "sidebar-ring": "#1d4ed8"
    },
    "dark": {
      "background": "#18181b",
      "foreground": "#f1f5f9",
      "card": "#3f3f46",
      "card-foreground": "#f1f5f9",
      "popover": "#3f3f46",
      "popover-foreground": "#f1f5f9",
      "primary": "#2563eb",
      "primary-foreground": "#ffffff",
      "secondary": "#d97706",
      "secondary-foreground": "#ffffff",
      "muted": "#27272a",
      "muted-foreground": "#94a3b8",
      "accent": "#27272a",
      "accent-foreground": "#f1f5f9",
      "destructive": "#ef4444",
      "border": "#3f3f46",
      "input": "#3f3f46",
      "ring": "#2563eb",
      "chart-1": "#93c5fd",
      "chart-2": "#fcd34d",
      "chart-3": "#6ee7b7",
      "chart-4": "#67e8f9",
      "chart-5": "#fca5a5",
      "sidebar": "#27272a",
      "sidebar-foreground": "#f1f5f9",
      "sidebar-primary": "#2563eb",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "#3f3f46",
      "sidebar-accent-foreground": "#f1f5f9",
      "sidebar-border": "#3f3f46",
      "sidebar-ring": "#2563eb"
    }
  },
  "type": "registry:theme"
}