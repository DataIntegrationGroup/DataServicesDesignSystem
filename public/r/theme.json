{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "OcotilloUI Theme (legacy)",
  "description": "Legacy: merges the OcotilloUI palette into the app's CSS as shadcn cssVars. New apps should install theme-base plus one theme file (theme-ocotillo, theme-nmwdi); see THEMING.md. OcotilloUI (NMBGMRDataManager) production palette and typography — the Ocotillo brand blue, amber, red, orange, emerald and teal over neutral greys. Outfit headings, Public Sans body.",
  "dependencies": [
    "@fontsource-variable/outfit",
    "@fontsource-variable/public-sans"
  ],
  "cssVars": {
    "theme": {
      "font-heading": "'Outfit Variable', system-ui, sans-serif",
      "font-sans": "'Public Sans Variable', system-ui, sans-serif"
    },
    "light": {
      "background": "#fafafa",
      "foreground": "#0f1521",
      "card": "#ffffff",
      "card-foreground": "#0f1521",
      "popover": "#ffffff",
      "popover-foreground": "#0f1521",
      "primary": "#0e6da8",
      "primary-foreground": "#ffffff",
      "secondary": "#dd7500",
      "secondary-foreground": "#ffffff",
      "muted": "#f2f2f2",
      "muted-foreground": "#737373",
      "accent": "#ebebeb",
      "accent-foreground": "#0f1521",
      "destructive": "#e7000b",
      "border": "#dedede",
      "input": "#dedede",
      "ring": "#0e6da8",
      "chart-1": "#0e6da8",
      "chart-2": "#dd7500",
      "chart-3": "#007a55",
      "chart-4": "#009689",
      "chart-5": "#e7000b",
      "radius": "0.375rem",
      "sidebar": "#fafafa",
      "sidebar-foreground": "#0f1521",
      "sidebar-primary": "#0e6da8",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "#ebebeb",
      "sidebar-accent-foreground": "#0f1521",
      "sidebar-border": "#dedede",
      "sidebar-ring": "#0e6da8"
    },
    "dark": {
      "background": "#181818",
      "foreground": "#f0f4f8",
      "card": "#404040",
      "card-foreground": "#f0f4f8",
      "popover": "#404040",
      "popover-foreground": "#f0f4f8",
      "primary": "#83c6ee",
      "primary-foreground": "#181818",
      "secondary": "#f2da4e",
      "secondary-foreground": "#181818",
      "muted": "#272727",
      "muted-foreground": "#97a1ae",
      "accent": "#272727",
      "accent-foreground": "#f0f4f8",
      "destructive": "#ff6467",
      "border": "#404040",
      "input": "#272727",
      "ring": "#83c6ee",
      "chart-1": "#83c6ee",
      "chart-2": "#f2da4e",
      "chart-3": "#5ee9b5",
      "chart-4": "#5eead4",
      "chart-5": "#ff6467",
      "sidebar": "#272727",
      "sidebar-foreground": "#f0f4f8",
      "sidebar-primary": "#83c6ee",
      "sidebar-primary-foreground": "#181818",
      "sidebar-accent": "#404040",
      "sidebar-accent-foreground": "#f0f4f8",
      "sidebar-border": "#404040",
      "sidebar-ring": "#83c6ee"
    }
  },
  "type": "registry:theme"
}