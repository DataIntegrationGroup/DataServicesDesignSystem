    {
      "name": "mode-toggle",
      "type": "registry:component",
      "title": "Mode Toggle",
      "description": "A light, dark and system mode menu built on next-themes.",
      "dependencies": [
        "next-themes",
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "dropdown-menu"
      ],
      "docs": "Wrap your app in next-themes' ThemeProvider with attribute=\"class\" so the toggle can set the .dark class.",
      "files": [
        {
          "path": "src/registry/base-nova/components/mode-toggle.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "base",
      "type": "registry:base",
      "title": "Data Services Base",
      "description": "Starts a new app on the Data Services design system: base-nova components, the Ocotillo theme and a mode toggle, with the @dataservices registry configured.",
      "config": {
        "style": "base-nova",
        "iconLibrary": "lucide",
        "tailwind": {
          "baseColor": "neutral"
        },
        "registries": {
          "@dataservices": "https://raw.githubusercontent.com/DataIntegrationGroup/DataServicesDesignSystem/main/public/r/{name}.json"
        }
      },
      "registryDependencies": [
        "@dataservices/theme-ocotillo",
        "@dataservices/mode-toggle"
      ]
    },
    {
      "name": "app-shell",
      "type": "registry:block",
      "title": "App Shell",
      "description": "The frame for tool-style apps: a sidebar that collapses to an icon rail, a top bar with search and actions, a content area that scrolls on its own, and an optional resizable side panel. Router-agnostic through pathname and renderLink.",
      "dependencies": [
        "cn",
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "collapsible",
        "kbd",
        "sidebar"
      ],
      "files": [
        {
          "path": "src/registry/base-nova/blocks/app-shell/app-shell.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "top-nav",
      "type": "registry:block",
      "title": "Top Nav",
      "description": "The navigation bar for content sites: the brand on the left, links in a NavigationMenu on the right, and a Sheet menu below the md breakpoint. Router-agnostic through pathname and renderLink.",
      "dependencies": [
        "cn",
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "navigation-menu",
        "sheet"
      ],
      "files": [
