{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dataservices",
  "homepage": "https://github.com/DataIntegrationGroup/DataServicesDesignSystem",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "OcotilloUI Theme",
      "description": "OcotilloUI (NMBGMRDataManager) production palette and typography — blue/amber/red/orange/emerald/cyan over stone (light) and zinc (dark) neutrals. Outfit headings, Public Sans body.",
      "dependencies": [
        "@fontsource-variable/outfit",
        "@fontsource-variable/public-sans"
      ],
      "cssVars": {
        "theme": {
          "font-heading": "'Outfit Variable', system-ui, sans-serif",
          "font-sans": "'Public Sans Variable', system-ui, sans-serif"
        },
        "light": {
          "background": "#e7e5e4",
          "foreground": "#0f172a",
          "card": "#ffffff",
          "card-foreground": "#0f172a",
          "popover": "#ffffff",
          "popover-foreground": "#0f172a",
          "primary": "#1d4ed8",
          "primary-foreground": "#ffffff",
          "secondary": "#d97706",
          "secondary-foreground": "#ffffff",
          "muted": "#f5f5f4",
          "muted-foreground": "#64748b",
          "accent": "#f5f5f4",
          "accent-foreground": "#0f172a",
          "destructive": "#dc2626",
          "border": "#d6d3d1",
          "input": "#d6d3d1",
          "ring": "#1d4ed8",
          "chart-1": "#1d4ed8",
          "chart-2": "#d97706",
          "chart-3": "#047857",
          "chart-4": "#0891b2",
          "chart-5": "#dc2626",
          "radius": "0.5rem",
          "sidebar": "#ffffff",
          "sidebar-foreground": "#0f172a",
          "sidebar-primary": "#1d4ed8",
          "sidebar-primary-foreground": "#ffffff",
          "sidebar-accent": "#f5f5f4",
          "sidebar-accent-foreground": "#0f172a",
          "sidebar-border": "#d6d3d1",
          "sidebar-ring": "#1d4ed8"
        },
        "dark": {
          "background": "#18181b",
          "foreground": "#f1f5f9",
          "card": "#3f3f46",
          "card-foreground": "#f1f5f9",
          "popover": "#3f3f46",
          "popover-foreground": "#f1f5f9",
          "primary": "#2563eb",
          "primary-foreground": "#ffffff",
          "secondary": "#d97706",
          "secondary-foreground": "#ffffff",
          "muted": "#27272a",
          "muted-foreground": "#94a3b8",
          "accent": "#27272a",
          "accent-foreground": "#f1f5f9",
          "destructive": "#ef4444",
          "border": "#3f3f46",
          "input": "#3f3f46",
          "ring": "#2563eb",
          "chart-1": "#93c5fd",
          "chart-2": "#fcd34d",
          "chart-3": "#6ee7b7",
          "chart-4": "#67e8f9",
          "chart-5": "#fca5a5",
          "sidebar": "#27272a",
          "sidebar-foreground": "#f1f5f9",
          "sidebar-primary": "#2563eb",
          "sidebar-primary-foreground": "#ffffff",
          "sidebar-accent": "#3f3f46",
          "sidebar-accent-foreground": "#f1f5f9",
          "sidebar-border": "#3f3f46",
          "sidebar-ring": "#2563eb"
        }
      }
    },
    {
      "name": "theme-provider",
      "type": "registry:component",
      "title": "Theme Provider",
      "description": "Light/dark/system theme context with localStorage persistence (storageKey 'dsds-theme'). Exposes useTheme().",
      "files": [
        {
          "path": "src/components/theme-provider.tsx",
          "type": "registry:component",
          "target": "components/theme-provider.tsx"
        }
      ]
    },
    {
      "name": "mode-toggle",
      "type": "registry:component",
      "title": "Mode Toggle",
      "description": "Light/dark toggle button. Tracks system preference when theme is 'system'.",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["button", "@dataservices/theme-provider"],
      "files": [
        {
          "path": "src/components/mode-toggle.tsx",
          "type": "registry:component",
          "target": "components/mode-toggle.tsx"
        }
      ]
    },
    {
      "name": "map",
      "type": "registry:ui",
      "title": "Map",
      "description": "MapLibre map primitive with a token-free CARTO basemap, New Mexico default extent, and nav/scale controls. Re-exports react-map-gl/maplibre primitives.",
      "dependencies": ["react-map-gl", "maplibre-gl"],
      "files": [
        {
          "path": "src/components/ui/map.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "navbar",
      "type": "registry:ui",
      "title": "NavBar",
      "description": "Router-agnostic top navigation chrome. Link slots accept the app's router Link via asChild.",
      "dependencies": ["radix-ui"],
      "files": [
        {
          "path": "src/components/ui/navbar.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "page",
      "type": "registry:ui",
      "title": "Page Shell",
      "description": "Full-viewport app chrome — PageShell (flex column) plus PageBody (scrollable, width-capped content column).",
      "files": [
        {
          "path": "src/components/ui/page.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
